# Image channel
# - edge: development/testing only
# - vX.Y.Z: production/self-host releases
APP_VERSION=v1.0.1
# Override these to use a mirror or another registry.
FRONTEND_IMAGE=ghcr.io/aedgaras/syllogic-frontend
BACKEND_IMAGE=ghcr.io/aedgaras/syllogic-backend

# Public URL for the app (single source of truth for auth + CORS defaults)
APP_URL=http://localhost:8080
# Direct host port for the app. This is used whether or not Caddy is enabled.
APP_PORT=8080

# BetterAuth secret (required in production)
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me

# Shared secret for app -> backend signed internal auth (required)
# Generate with: openssl rand -hex 32
INTERNAL_AUTH_SECRET=change-me

# Optional Caddy reverse proxy (enable with prod-up.sh --caddy):
# Caddy's host ports must differ from APP_PORT.
# Caddy site address:
# - Use :80 for localhost/LAN HTTP-only installs
# - Set to a domain for internet-facing deployments so HTTPS is enabled
CADDY_ADDRESS=:80
# Host port mappings for Caddy
HTTP_PORT=80
# HTTPS_PORT=443
# ACME_EMAIL=you@example.com

# Postgres
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_USER=financeuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finance_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# Production should enforce TLS:
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=require

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
BACKEND_URL=http://backend:8000
# Runtime sizing. The lite deployment overrides these defaults to 2/2.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# CELERY_CONCURRENCY=4
# CELERY_POOL=prefork
# Optional explicit CORS allowlist (comma-separated).
# Defaults to APP_URL when omitted.
# CORS_ALLOW_ORIGINS=http://localhost:8080

# Healthcheck URLs (optional overrides)
# BACKEND_HEALTHCHECK_URL=http://backend:8000/health/ready
# APP_HEALTHCHECK_URL=http://app:3000/

# Build (optional)
# NEXT_DISABLE_TURBOPACK=1

# Optional lite-mode memory limits. Defaults are suitable for a 2 GB Pi.
# POSTGRES_MEMORY_LIMIT=256m
# REDIS_MEMORY_LIMIT=64m
# MIGRATE_MEMORY_LIMIT=256m
# BACKEND_MEMORY_LIMIT=384m
# WORKER_MEMORY_LIMIT=512m
# APP_MEMORY_LIMIT=384m
# CADDY_MEMORY_LIMIT=64m
# Only applies in lite mode, and only when the MCP container is started
# with prod-up.sh --lite --mcp.
# MCP_MEMORY_LIMIT=256m

# MCP
# Client setup guide: docs/mcp.md
# Internal port is fixed at 8001.
# External host port defaults to 8001 and can be overridden.
# MCP_PORT=9001
# Bound to 127.0.0.1 by default (single-user service, not meant for direct
# internet exposure). Set to 0.0.0.0 only if you're deliberately exposing it
# to a trusted network or fronting it with an auth layer.
# MCP_BIND_ADDR=0.0.0.0
# Optional override for Claude Desktop snippet URL shown in the app settings.
# If unset, the frontend derives from BETTER_AUTH_URL/APP_URL.
# MCP_SERVER_URL=https://mcp.example.com/mcp
# Public URL the MCP service advertises for OAuth resource discovery and as
# the JWT audience. Defaults to http://localhost:8001; set this to the
# externally reachable URL if the MCP service is exposed behind a proxy.
# MCP_PUBLIC_URL=https://mcp.example.com
# Off by default: allow MCP clients to self-register as OAuth clients
# (RFC 7591) without authenticating first. Only needed if you want MCP
# clients other than Claude Desktop/Code with a pf_ API key to connect.
# MCP_OAUTH_ALLOW_DYNAMIC_REGISTRATION=true
# How long (seconds) the MCP service reuses the result of a key's bcrypt
# comparison (~200ms), which an agent would otherwise pay on every single
# tool call. 0 disables the cache. Default 60. Revoked keys are not affected
# by this -- see MCP_API_KEY_REVOCATION_CHECK_INTERVAL.
# MCP_API_KEY_CACHE_TTL=60
# How often (seconds) a cached key is re-read from the database to confirm it
# has not been revoked. 0 (the default) checks on every call, so deleting a
# key stops it working immediately; the check is one primary-key lookup.
# Raising this saves that lookup and lets a revoked key keep working for up
# to this many seconds -- only worth it under heavy tool-call volume.
# MCP_API_KEY_REVOCATION_CHECK_INTERVAL=0
# How often (seconds) an API key's last_used_at timestamp is refreshed while
# it is being used continuously. Default 60; 0 writes on every call.
# MCP_API_KEY_LAST_USED_INTERVAL=60
# Tool calls allowed per authenticated user per window. 0 disables the
# per-user limiter. Default 240 per 60s.
# MCP_USER_RATE_LIMIT=240
# MCP_USER_RATE_LIMIT_WINDOW=60
# Requests allowed per client IP per window, applied before authentication --
# this is what throttles API-key guessing. Everyone behind one egress address
# shares a bucket, so raise it if several people reach the server through the
# same NAT or VPN. Default 60 per 60s.
# MCP_IP_RATE_LIMIT=60
# MCP_IP_RATE_LIMIT_WINDOW=60
# Toolsets every session is given on top of `core`, comma-separated, or `all`.
# A session opens on `core` (accounts, transactions, categories, analytics)
# and reaches the rest -- transaction editing, budgets, recurring bills,
# investments, scheduled reports -- by calling `load_toolset`, which keeps
# roughly 22,000 tokens of tool schemas out of every session that never needs
# them. That only works on a client that re-lists on tools/list_changed.
# Claude Code and the claude.ai connectors do not: `load_toolset` succeeds,
# the server's surface widens, and the client then refuses the call as an
# unknown tool. Set this to `all` for those clients (or put `?toolsets=all`
# on the MCP URL, which overrides this per connection).
# MCP_DEFAULT_TOOLSETS=all
# Reverse proxies allowed to identify the real client via X-Forwarded-For,
# as a comma-separated list of addresses or CIDRs. Leave empty unless the MCP
# service sits behind a proxy you control: the header is written by whoever
# sends the request, so trusting it from an arbitrary source lets an attacker
# hand themselves a fresh rate-limit bucket per request. When the peer is
# listed here, only the rightmost hop that isn't itself listed is believed.
# Without it, every caller behind the proxy shares one bucket.
# TRUSTED_PROXIES=172.16.0.0/12

# Optional features / integrations
#
# LLM: Enables AI categorization and CSV column mapping through OpenAI or any
# server exposing an OpenAI-compatible /v1/chat/completions endpoint.
# For OpenAI, leave LLM_BASE_URL empty. For a local server, set its URL and use
# any non-empty placeholder key if the server does not require authentication.
# From Docker Desktop, a host Ollama endpoint is usually:
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=local-llm
# LLM_MODEL=qwen3:8b
# Legacy OPENAI_API_KEY and OPENAI_BASE_URL variables remain supported.
# When no LLM configuration is present, categorization uses keyword matching.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
#
# LLM fallback: used automatically when the provider above returns a
# quota/auth/rate-limit error (e.g. a paid key ran out of credit). Point it
# at a local Ollama/vLLM server for a free backstop, or leave empty to
# disable. This is deployment-only — no per-user setting for it.
# LLM_FALLBACK_BASE_URL=http://host.docker.internal:11434/v1
# LLM_FALLBACK_API_KEY=local-llm
# LLM_FALLBACK_MODEL=qwen3:8b
#
# LOGO_DEV_API_KEY: Enables company logo lookup via logo.dev API.
# - When set: Merchant logos are fetched and displayed for transactions/accounts.
# - When NOT set: No logos are shown; the feature is silently disabled.
# LOGO_DEV_API_KEY=

# Optional application-layer encryption (recommended for production).
# Use a 32-byte key encoded as base64 or hex.
# DATA_ENCRYPTION_KEY_CURRENT=
# DATA_ENCRYPTION_KEY_PREVIOUS=
# DATA_ENCRYPTION_KEY_ID=k1

# Logging
# Level: debug | info | warn | error. Also adjustable at runtime from
# Settings > Authentication (admin) in the app, without a restart.
LOG_LEVEL=info
# Backend/worker/beat/mcp log format: text or json (recommended in production).
LOG_FORMAT=json
# Frontend browser console level (baked in at build time, not UI-adjustable).
NEXT_PUBLIC_LOG_LEVEL=warn

# Optional: POST unhandled-backend-exception details (message, traceback,
# request id) to this URL -- a custom collector, an internal alerting
# endpoint, anything that accepts a JSON POST. No error tracking by
# default; unset means this is a no-op.
# ERROR_REPORTING_WEBHOOK_URL=
