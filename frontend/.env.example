# Database (Docker Compose defaults)
DATABASE_URL=postgresql://financeuser:financepass@localhost:5433/finance_db
# Production example:
# DATABASE_URL=postgresql://financeuser:financepass@db:5432/finance_db?sslmode=require

# BetterAuth
BETTER_AUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Optional application-layer encryption (recommended for production).
# Use a 32-byte key encoded as base64 or hex.
# DATA_ENCRYPTION_KEY_CURRENT=
# DATA_ENCRYPTION_KEY_PREVIOUS=
# DATA_ENCRYPTION_KEY_ID=k1

# OIDC credentials configured by an administrator in Settings are encrypted
# with DATA_ENCRYPTION_KEY_CURRENT. No OIDC-specific environment variables are needed.

# Backend API
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Optional MCP endpoint override used for Claude Desktop config snippets.
# If unset, the app derives this from BETTER_AUTH_URL/APP_URL at runtime.
# MCP_SERVER_URL=https://mcp.syllogic.ai/mcp

# Public demo login prefill (used by /login?demo=1)
# NOTE: NEXT_PUBLIC_ variables are embedded at build time.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

# Playwright mobile smoke tests
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_TEST_EMAIL=
# PLAYWRIGHT_TEST_PASSWORD=
# PLAYWRIGHT_ACCOUNT_ID=
# PLAYWRIGHT_IMPORT_ID=
# PLAYWRIGHT_SKIP_WEB_SERVER=

# Disable new user registrations (redirects /register to /login, hides sign-up link)
# Optional deployment-level hard override. The first bootstrap registration is
# still allowed so a fresh deployment cannot lock itself out.
DISABLE_SIGN_UPS=false

# Auth API rate limiting (frontend /api/auth proxy)
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_ATTEMPTS_PER_WINDOW=30
# Optional stricter limits for shared demo account sign-in
DEMO_AUTH_RATE_LIMIT_MAX_ATTEMPTS_PER_WINDOW=10
DEMO_AUTH_RATE_LIMIT_GLOBAL_MAX_ATTEMPTS_PER_WINDOW=120

# App + backend URLs
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Internal app <-> backend auth (required)
# Must match the backend's INTERNAL_AUTH_SECRET; HMAC-signs /internal/* and /api/* calls.
# Generate with: openssl rand -hex 32
INTERNAL_AUTH_SECRET=

# Logging
# Server level: debug | info | warn | error. Can also be changed at runtime
# from Settings > Authentication (admin), without a restart — it shares the
# same database setting as the backend's LOG_LEVEL. This env var is only the
# fallback used when no database override is set.
LOG_LEVEL=info
# Browser console level. NEXT_PUBLIC_ vars are inlined at build time, so this
# is not adjustable from the UI at runtime like the server level above.
NEXT_PUBLIC_LOG_LEVEL=warn
